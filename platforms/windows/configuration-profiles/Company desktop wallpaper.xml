<!--
  Company desktop wallpaper for Windows workstations (Personalization CSP).

  DesktopImageUrl: an http/https URL to a .jpg, .jpeg, or .png, or a file:///
  URL to an image already on the device. Windows downloads/copies it and sets
  it as the desktop background; users can't change it while this is applied.

  TODO: fill in <Data> with the wallpaper location before merging.

  Applies to Windows Enterprise and Education. On Windows Pro it only works in
  Shared PC / SetEduPolicies mode, otherwise it's a no-op.
-->
<Replace>
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">chr</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Personalization/DesktopImageUrl</LocURI>
    </Target>
    <Data></Data>
  </Item>
</Replace>
